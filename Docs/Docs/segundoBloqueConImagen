
-- Imagenes demo
IF NOT EXISTS (
    SELECT 1 FROM IMAGENES I
    INNER JOIN PRODUCTOS P ON P.IdProducto = I.IdProducto
    WHERE P.Sku = 'CEL-SAM-S24'
)
BEGIN
    INSERT INTO IMAGENES (IdProducto, Nombre, UrlImagen)
    SELECT IdProducto, 'Imagen principal', 'https://shopq1.assurancewireless.com/wp-content/uploads/2024/10/Samsung_Galaxy_S24_Black_front.png'
    FROM PRODUCTOS
    WHERE Sku = 'CEL-SAM-S24';
END
