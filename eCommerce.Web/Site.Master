<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="eCommerce.Web.SiteMaster" %>

<!DOCTYPE html>

<html lang="es">
<head runat="server">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - eCommerce UTN</title>

    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/bundles/modernizr") %>
    </asp:PlaceHolder>

    <webopt:BundleReference runat="server" Path="~/Content/css" />
    <link href="<%= ResolveUrl("~/Content/ecommerce-custom.css") %>" rel="stylesheet" type="text/css" />
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />

</head>
<body>
    <form runat="server">
        <asp:ScriptManager runat="server">
            <Scripts>
                <%--Framework Scripts--%>
                <asp:ScriptReference Name="MsAjaxBundle" />
                <asp:ScriptReference Name="jquery" />
                <asp:ScriptReference Name="WebForms.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebForms.js" />
                <asp:ScriptReference Name="WebUIValidation.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebUIValidation.js" />
                <asp:ScriptReference Name="MenuStandards.js" Assembly="System.Web" Path="~/Scripts/WebForms/MenuStandards.js" />
                <asp:ScriptReference Name="GridView.js" Assembly="System.Web" Path="~/Scripts/WebForms/GridView.js" />
                <asp:ScriptReference Name="DetailsView.js" Assembly="System.Web" Path="~/Scripts/WebForms/DetailsView.js" />
                <asp:ScriptReference Name="TreeView.js" Assembly="System.Web" Path="~/Scripts/WebForms/TreeView.js" />
                <asp:ScriptReference Name="WebParts.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebParts.js" />
                <asp:ScriptReference Name="Focus.js" Assembly="System.Web" Path="~/Scripts/WebForms/Focus.js" />
                <asp:ScriptReference Name="WebFormsBundle" />
                <%--Site Scripts--%>
            </Scripts>
        </asp:ScriptManager>

        <nav class="navbar navbar-expand-sm navbar-toggleable-sm app-navbar">
            <div class="container">
                <a class="navbar-brand app-navbar-brand" runat="server" href="~/">
                    <span class="app-brand-icon" aria-hidden="true">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                            <path d="M4 10H20L18.5 4H5.5L4 10Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
                            <path d="M4 10C4 11.7 5.3 13 7 13C8.7 13 10 11.7 10 10" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                            <path d="M10 10C10 11.7 11.3 13 13 13C14.7 13 16 11.7 16 10" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                            <path d="M16 10C16 11.7 17.3 13 19 13C20.7 13 22 11.7 22 10" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                            <path d="M6 13V20H18V13" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                        </svg>
                    </span>
                    <span>UTN eCommerce</span>
                </a>
                <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" title="Alternar navegación" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="nav-link" runat="server" href="~/">Inicio</a></li>
                        <li class="nav-item"><a class="nav-link" runat="server" href="~/Catalogo">Catalogo</a></li>
                        <li class="nav-item"><a class="nav-link" runat="server" href="~/Carrito">Carrito</a></li>
                    </ul>
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item" runat="server" id="liIngresar"><a class="nav-link" runat="server" href="~/Login">Ingresar</a></li>
                        <li class="nav-item" runat="server" id="liRegistrarse"><a class="nav-link" runat="server" href="~/Registro">Registrarse</a></li>
                        <li class="nav-item" runat="server" id="liMiPerfil"><a class="nav-link" runat="server" href="~/MiPerfil">Mi perfil</a></li>
                        <li class="nav-item" runat="server" id="liMisCompras"><a class="nav-link" runat="server" href="~/MisCompras">Mis compras</a></li>
                        <li class="nav-item" runat="server" id="liAdmin"><a class="nav-link" runat="server" href="~/Admin">Panel de Administracion</a></li>
                        <li class="nav-item" runat="server" id="liCerrarSesion">
                            <asp:LinkButton runat="server" ID="btnCerrarSesion" CssClass="nav-link" OnClick="btnCerrarSesion_Click">Cerrar sesion</asp:LinkButton>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
        <div class="container body-content">
            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>
            <hr />
            <footer>
                <p>&copy; <%: DateTime.Now.Year %> - TPI Programacion 3 - UTN FRGP</p>
            </footer>
        </div>
    </form>
    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/Scripts/bootstrap.js") %>
    </asp:PlaceHolder>
</body>
</html>
